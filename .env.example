# Application
APP_ENV=local
LOG_LEVEL=INFO
EXECUTION_MODE=shadow
ALLOW_LIVE_TRADING=false
DATABASE_URL=sqlite+aiosqlite:///./data/fictional-engine.db

# Telegram user API
# Obtain API_ID and API_HASH from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION=
TELEGRAM_CHANNEL_ID=
TELEGRAM_HISTORY_LIMIT=100

# TradeLocker
# Exact authentication fields must follow the verified broker/account flow.
TRADELOCKER_ENV=demo
TRADELOCKER_BASE_URL=
TRADELOCKER_USERNAME=
TRADELOCKER_PASSWORD=
TRADELOCKER_SERVER=
TRADELOCKER_ACCOUNT_ID=
TRADELOCKER_ACCESS_TOKEN=

# Execution safety
TARGET_SYMBOL=US30
BROKER_SYMBOL=
SIGNAL_PRICE_SOURCE=
ORDER_SIZE_MODE=fixed_quantity
DEFAULT_FIXED_QUANTITY=0.01
MAX_RISK_PERCENT=0.25
MAX_SIGNAL_AGE_SECONDS=90
MAX_PRICE_DEVIATION_POINTS=
MAX_OPEN_POSITIONS=1
MAX_PENDING_ORDERS=2
OPERATOR_KILL_SWITCH=true

# Scoring: advisory only
QUALITY_SCORING_ENABLED=false
QUALITY_MODEL_VERSION=rules-v1
